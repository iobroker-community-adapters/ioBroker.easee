{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "noEmitOnError": true,
        "rootDir": "./src",
        "outDir": "./build",
        "rewriteRelativeImportExtensions": true
    },
    "include": [
        "src/main.ts",
        "src/lib/**/*.ts"
    ],
    "exclude": [
        "**/build",
        "node_modules/",
        "admin/"
    ]
}
