{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "noEmitOnError": true,
        "rootDir": ".",
        "outDir": "./build",
        "rewriteRelativeImportExtensions": true
    },
    "include": [
        "main.ts",
        "lib/**/*.ts"
    ],
    "exclude": [
        "**/build",
        "node_modules/",
        "admin/"
    ]
}
