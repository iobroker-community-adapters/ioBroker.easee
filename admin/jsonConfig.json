{
    "i18n": true,
    "type": "panel",
    "items": {
        "_Headline2": {
            "newLine": true,
            "type": "header",
            "size": 2,
            "text": "Account Settings"
        },
        "username": {
            "newLine": true,
            "type": "text",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "label": "Username",
            "help": "Username to access Easee cloud"
        },
        "client_secret": {
            "type": "password",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "label": "Password",
            "help": "password of Easee cloud"
        },
        "_Headline3": {
            "newLine": true,
            "type": "header",
            "size": 2,
            "text": "API settings"
        },
        "polltime": {
            "type": "number",
            "min": 360,
            "max": 86400,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "label": "polltime",
            "help": "Poll interval in seconds"
        },
        "_sessionPollingHeadline": {
            "newLine": true,
            "type": "header",
            "size": 2,
            "text": "Session polling"
        },
        "sessionPollMode": {
            "type": "select",
            "options": [
                { "label": "Automatic", "value": "auto" },
                { "label": "Manual", "value": "manual" }
            ],
            "default": "auto",
            "label": "Session polling mode",
            "help": "Automatic mode uses seven minutes per detected charger. Manual mode sets the desired interval per charger."
        },
        "sessionPollInterval": {
            "type": "number",
            "min": 7,
            "step": 1,
            "unit": "min",
            "default": 60,
            "label": "Manual session interval per charger",
            "help": "Intervals below the recommendation are conservatively clamped to the recommendation.",
            "hidden": "data.sessionPollMode !== 'manual'"
        },
        "_sessionChargerCount": {
            "newLine": true,
            "type": "state",
            "oid": "info.sessionPollChargerCount",
            "control": "text",
            "xs": 12,
            "sm": 8,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "label": "Detected chargers"
        },
        "_sessionRecommendedInterval": {
            "newLine": true,
            "type": "state",
            "oid": "info.sessionPollRecommendedInterval",
            "control": "text",
            "xs": 12,
            "sm": 8,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "unit": "min",
            "label": "Recommended interval per charger"
        },
        "_sessionEffectiveInterval": {
            "newLine": true,
            "type": "state",
            "oid": "info.sessionPollEffectiveInterval",
            "control": "text",
            "xs": 12,
            "sm": 8,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "unit": "min",
            "label": "Effective interval per charger"
        },
        "_sessionIntervalWarning": {
            "type": "infoBox",
            "boxType": "warning",
            "closeable": false,
            "text": "The configured interval is below the recommendation and will be clamped.",
            "dependsOnStates": { "chargerCount": ".info.sessionPollChargerCount" },
            "hidden": "data.sessionPollMode !== 'manual' || !_states.chargerCount?.val || data.sessionPollInterval >= _states.chargerCount.val * 7"
        },
        "signalR": {
            "newLine": true,
            "type": "checkbox",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "label": "Use SignalR"
        },
        "logtype": {
            "type": "checkbox",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "label": "detailed info logging",
            "help": "provide additional logging in info area"
        }
    }
}
