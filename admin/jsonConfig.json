        "_Headline2": {
            "newLine": true,
            "type": "header",
            "size": 2,
            "text": "Account settings",
            "hidden": "data.connectionMode !== 'cloud'"
        },
        "connectionMode": {
            "newLine": true,
            "type": "select",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "options": [
                { "label": "Easee Cloud", "value": "cloud" },
                { "label": "Bluetooth (local)", "value": "bluetooth" }
            ],
            "default": "cloud",
            "label": "Connection mode"
        },
        "_bluetoothInfo": {
            "newLine": true,
            "type": "infoBox",
            "boxType": "info",
            "closeable": false,
            "text": "Bluetooth mode requires a compatible Bluetooth LE adapter and platform-specific permissions. Enter each charger in the fields below (up to 10); each PIN is encrypted. See the Bluetooth guide for setup and limitations.",
            "hidden": "data.connectionMode !== 'bluetooth'"
        },
        "_bluetoothCharger1": {
